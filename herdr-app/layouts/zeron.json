{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.12"
  },
  "type": "row",
  "theme": "zeron",
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "preview": "layouts/zeron.svg",
  "background": "canvas",
  "terminal_padding": [18, 26],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": { "px": 252 },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": { "px": 44 },
          "window_drag": true,
          "content": { "mod": "workspace-chrome" }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "sessions",
              "type": "block",
              "min": 90,
              "content": { "mod": "zeron-sessions" }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": { "px": 69 },
          "content": {
            "mod": "workspace-chrome",
            "props": { "footer": true }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": { "px": 40 },
          "window_drag": true,
          "content": { "mod": "tabs" }
        },
        {
          "id": "work-body",
          "type": "row",
          "gap": 1,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 1,
                  "radius": 0,
                  "background": "background",
                  "lone": false,
                  "border": { "width": 1, "color": "border" },
                  "focus": { "width": 1, "color": "border" },
                  "header": {
                    "content": { "mod": "pane" },
                    "height": 30,
                    "position": "top",
                    "reveal": "hover"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": { "px": 368 },
              "min": 280,
              "max": 900,
              "background": "chrome",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": { "mod": "files" }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": { "mod": "changes" }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": { "px": 26 },
          "content": { "mod": "workspace-status" }
        }
      ]
    }
  ]
}
